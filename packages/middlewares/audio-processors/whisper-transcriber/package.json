  "homepage": "https://awslabs.github.io/project-lakechain/",
  "devDependencies": {
    "@types/node": "^25.0.10",
    "cdk-nag": "^3.0.2",
    "esbuild": "0.28.2",
    "rimraf": "^6.1.2",
    "shx": "^0.4.0",
    "vitest": "5.0.0"
  },
  "dependencies": {
    "@project-lakechain/core": "^0.10.0",
    "@project-lakechain/ecs-cluster": "^0.10.0"
