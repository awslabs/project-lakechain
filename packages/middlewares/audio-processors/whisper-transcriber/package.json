{
  "name": "@project-lakechain/whisper-transcriber",
  "description": "An audio document transcription middleware based on OpenAI Whisper.",
  "version": "0.10.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "npx tsc",
