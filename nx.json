{
  "targetDefaults": {
    "build": {
      "cache": true,
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "{projectRoot}/dist/"
      ]
    },
    "build-pkg": {
      "cache": true,
      "dependsOn": [
        "^build-pkg"
      ],
      "outputs": [
        "{projectRoot}/dist/"
      ]
    },
    "clean": {
      "dependsOn": [
        "^clean"
      ]
    },
    "audit": {
      "dependsOn": [
        "^audit"
      ]
    },
    "lint": {
      "cache": true,
      "dependsOn": [
        "^lint"
      ]
    },
    "synth": {
      "dependsOn": [
        "^build",
        "^synth"
      ]
    },
    "test": {
      "dependsOn": [
        "build"
      ]
    },
    "test:coverage": {
      "dependsOn": [
        "^test:coverage"
      ]
    },
    "postbuild": {
      "dependsOn": [
        "^postbuild"
      ]
    }
  },
  "analytics": false
}