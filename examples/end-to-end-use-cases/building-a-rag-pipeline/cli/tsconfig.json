{
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "strict": true,
    "target": "ESNext",
    "module": "NodeNext",
    "sourceMap": true,
    "esModuleInterop": true,
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "resolveJsonModule": true
  },
  "include": ["./src/**/*"],
  "exclude": ["./dist"]
}
